# 조직 하나를 조회할 때 사용합니다.
SENTRY_AUTH_TOKEN=

# 여러 조직을 조회할 때 SENTRY_AUTH_TOKEN 대신 사용합니다.
# SENTRY_TOKENS_JSON={"org-a":"token-a","org-b":"token-b"}
SENTRY_TOKENS_JSON=

DISCORD_WEBHOOK_URL=

# 선택 사항: API 키가 없으면 로컬 Codex CLI, 그것도 없으면 규칙 기반으로 분석합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
CODEX_CLI_ANALYSIS=1

MAX_ISSUES_PER_RUN=30
REPORTS_DIR=reports
DRY_RUN=0
